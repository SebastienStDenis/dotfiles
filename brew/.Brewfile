# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Run macOS virtual machines locally and build images for use with Orka
cask "orka-desktop"
# System monitor for the menu bar
cask "stats"
# Text editor for code, markup and prose
cask "sublime-text"
