[init]
    defaultBranch = main

[user]
    name = Sébastien St-Denis
    # The email is per-machine and lives in ~/.gitconfig.local. useConfigOnly
    # makes a missing one a hard error at commit time rather than a guess from
    # the hostname, so work commits can't silently land under a personal address.
    useConfigOnly = true

[core]
    editor = nvim
    autocrlf = input

[pull]
    ff = only

[fetch]
    prune = true

[rebase]
    autostash = true

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[push]
    default = upstream
    autoSetupRemote = true

[pager]
    branch = false

[alias]
    ad = add
    br = branch
    sw = switch
    cp = cherry-pick
    cm = commit
    rs = reset
    df = diff
    lg = log
    st = status
    rb = rebase
    pl = pull
    pr = prune
    ps = push
    wt = worktree
    tr = trim

# Per-machine email and overrides. Not tracked here; git ignores it when absent.
# Create with: make git-identity EMAIL="you@example.com"
[include]
    path = ~/.gitconfig.local

