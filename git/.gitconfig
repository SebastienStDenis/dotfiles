[init]
    defaultBranch = main

[user]
    name = Sébastien St-Denis
    email = sebastien.stdenis@icloud.com

[core]
    editor = nvim
    autocrlf = input

[pull]
    ff = only

[fetch]
    prune = true

[rebase]
    autostash = true

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[push]
    default = upstream
    autoSetupRemote = true

[pager]
    branch = false

[alias]
    ad = add
    br = branch
    sw = switch
    cp = cherry-pick
    cm = commit
    rs = reset
    df = diff
    lg = log
    st = status
    rb = rebase
    pl = pull
    ps = push
    wt = worktree
    tr = trim

